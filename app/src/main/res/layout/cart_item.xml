<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Tên sản phẩm -->
    <TextView
        android:id="@+id/txtProductName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Product Name"
        android:textSize="16sp"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imgDelete" />

    <!-- Giá sản phẩm -->
    <TextView
        android:id="@+id/txtProductPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Price"
        android:textSize="14sp"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtProductName" />

    <!-- Nút giảm số lượng -->
    <ImageButton
        android:id="@+id/btnDecrease"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_decre"
        android:background="@drawable/bg_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtProductPrice"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scaleType="centerInside"/>
    <!-- Số lượng sản phẩm -->
    <TextView
        android:id="@+id/txtProductQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="16sp"
        android:padding="8dp"
        app:layout_constraintStart_toEndOf="@id/btnDecrease"
        app:layout_constraintTop_toBottomOf="@id/txtProductPrice"
        app:layout_constraintBottom_toBottomOf="parent" />


    <!-- Nút tăng số lượng -->

    <ImageButton
        android:id="@+id/btnIncrease"
        android:layout_width="50dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_incre"
        android:background="@drawable/bg_circle"
        app:layout_constraintStart_toEndOf="@id/txtProductQuantity"
        app:layout_constraintTop_toBottomOf="@id/txtProductPrice"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scaleType="centerInside"/>
    <!-- Nút xóa sản phẩm -->
    <ImageView
        android:id="@+id/imgDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_delete"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="45dp"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
